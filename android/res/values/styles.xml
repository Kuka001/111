<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The app's dark background from the very first frame: the launch screen
      (Android 12+ splash) and the window behind the WebView use it, so there is
      no flash of the system theme before the UI paints.
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_navigation</item>
    </style>
</resources>
